.venue-name {
  margin-bottom: 10rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.form-card {
  display: block;
}

.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.label {
  margin-bottom: 14rpx;
  color: #344054;
  font-weight: 700;
}

.picker-value,
.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f7f8;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
}

.textarea {
  height: 150rpx;
  padding-top: 20rpx;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
}

.slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50%;
  height: 78rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 12rpx;
  color: #344054;
  font-weight: 700;
  box-sizing: border-box;
}

.slot-active {
  border-color: #c2185b;
  background: #ffe4ef;
  color: #c2185b;
}
