.venue-name {
  margin-bottom: 10rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.label {
  color: #344054;
  font-weight: 700;
}

.picker-value,
.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f7f8;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
}

.textarea {
  height: 150rpx;
  padding-top: 20rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.slot {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 12rpx;
  color: #344054;
  font-weight: 700;
}

.slot-active {
  border-color: #1f6f78;
  background: #e7f5f6;
  color: #1f6f78;
}
