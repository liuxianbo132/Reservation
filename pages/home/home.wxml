<view class="page">
  <view class="hero">
    <view>
      <text class="hero-kicker">Reservation</text>
      <view class="hero-title">预约场地</view>
      <view class="hero-subtitle">选择场地、时间，提交预约申请。</view>
    </view>
  </view>

  <view class="section-title">可预约场地</view>

  <view class="venue-list">
    <view class="venue-card card" wx:for="{{venues}}" wx:key="id" bindtap="goVenue" data-id="{{item.id}}">
      <image class="venue-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="venue-content">
        <view class="venue-top">
          <view class="venue-name">{{item.name}}</view>
          <text class="tag">{{item.type}}</text>
        </view>
        <view class="venue-line muted">{{item.location}}</view>
        <view class="venue-meta">
          <text>{{item.openTime}}</text>
          <text>￥{{item.price}}/小时</text>
        </view>
      </view>
    </view>
  </view>
</view>
