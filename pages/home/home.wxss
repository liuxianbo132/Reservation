.hero {
  display: flex;
  align-items: flex-end;
  min-height: 260rpx;
  padding: 32rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1f6f78, #69a297);
  box-sizing: border-box;
}

.hero-kicker {
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.venue-card {
  padding: 0;
  margin-bottom: 22rpx;
  overflow: hidden;
}

.venue-image {
  width: 100%;
  height: 260rpx;
  display: block;
}

.venue-content {
  padding: 22rpx;
}

.venue-top,
.venue-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.venue-name {
  font-size: 32rpx;
  font-weight: 700;
}

.venue-line {
  margin-top: 12rpx;
}

.venue-meta {
  margin-top: 16rpx;
  color: #1f6f78;
  font-weight: 700;
}
