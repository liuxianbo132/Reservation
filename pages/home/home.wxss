.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 300rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #8a0f3f, #c2185b 52%, #ff7ab6);
  box-sizing: border-box;
  box-shadow: 0 22rpx 48rpx rgba(194, 24, 91, 0.24);
}

.hero-copy {
  flex: 1;
}

.hero-kicker {
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.hero-panel {
  width: 150rpx;
  padding: 24rpx 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
}

.hero-number {
  font-size: 48rpx;
  font-weight: 800;
}

.hero-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.quick-row {
  display: flex;
  margin: 24rpx -8rpx 0;
}

.quick-card {
  flex: 1;
  margin: 0 8rpx;
  padding: 20rpx 10rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.05);
}

.quick-value {
  color: #c2185b;
  font-size: 30rpx;
  font-weight: 800;
}

.quick-label {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 18rpx;
}

.section-head .section-title {
  margin: 0;
}

.section-note {
  color: #667085;
  font-size: 24rpx;
}

.venue-card {
  padding: 0;
  margin-bottom: 26rpx;
  overflow: hidden;
}

.image-wrap {
  position: relative;
}

.venue-image {
  width: 100%;
  height: 300rpx;
  display: block;
}

.image-badge {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(24, 34, 48, 0.72);
  color: #ffffff;
  font-size: 24rpx;
}

.venue-content {
  padding: 22rpx;
}

.venue-top,
.venue-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.venue-name {
  font-size: 32rpx;
  font-weight: 700;
}

.venue-line {
  margin-top: 12rpx;
}

.venue-meta {
  margin-top: 16rpx;
  color: #c2185b;
  font-weight: 700;
  font-size: 24rpx;
}
