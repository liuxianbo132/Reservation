.cover {
  width: 100%;
  height: 430rpx;
  border-radius: 24rpx;
  display: block;
  box-shadow: 0 18rpx 42rpx rgba(16, 24, 40, 0.12);
}

.detail-card {
  margin-top: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 800;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f5f7f8;
  color: #c2185b;
  font-size: 24rpx;
  font-weight: 700;
}

.info {
  margin-top: 18rpx;
  line-height: 1.7;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 30rpx;
}

.info-grid > view {
  width: 50%;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.label {
  margin-bottom: 8rpx;
  color: #667085;
  font-size: 24rpx;
}
