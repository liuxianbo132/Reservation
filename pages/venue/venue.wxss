.cover {
  width: 100%;
  height: 420rpx;
  border-radius: 18rpx;
  display: block;
}

.detail-card {
  margin-top: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 800;
}

.info {
  margin-top: 18rpx;
  line-height: 1.7;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 30rpx;
}

.label {
  margin-bottom: 8rpx;
  color: #667085;
  font-size: 24rpx;
}
