<view class="page">
  <view class="section-title">预约管理</view>

  <view class="empty card" wx:if="{{isEmpty}}">
    <view class="empty-title">暂无预约</view>
    <view class="muted">用户提交预约后，会显示在这里。</view>
  </view>

  <view class="booking-list" wx:if="{{hasBookings}}">
    <view class="card booking-card" wx:for="{{bookings}}" wx:key="id">
      <view class="booking-top">
        <view>
          <view class="booking-title">{{item.venueName}}</view>
          <view class="muted">{{item.date}} · {{item.slot}}</view>
        </view>
        <text class="status">{{item.status}}</text>
      </view>
      <view class="muted">联系人：{{item.contactName}} · {{item.phone}}</view>
      <view class="muted" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      <view class="actions">
        <button class="mini confirm" size="mini" data-id="{{item.id}}" bindtap="confirmBooking">确认</button>
        <button class="mini cancel" size="mini" data-id="{{item.id}}" bindtap="cancelBooking">取消</button>
        <button class="mini danger" size="mini" data-id="{{item.id}}" bindtap="deleteBooking">删除</button>
      </view>
    </view>
  </view>
</view>
