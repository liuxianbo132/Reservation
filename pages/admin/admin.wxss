.empty {
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.booking-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 18rpx;
}

.booking-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.booking-title {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4df;
  color: #b54708;
  font-size: 24rpx;
}

.actions {
  display: flex;
  margin-top: 8rpx;
}

.mini {
  flex: 1;
  margin: 0;
  border-radius: 10rpx;
}

.confirm {
  margin-right: 16rpx;
  background: #1f6f78;
  color: #ffffff;
}

.cancel {
  background: #fef3f2;
  color: #b42318;
}
